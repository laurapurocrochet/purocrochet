# ==========================================
# PURO CROCHET - VARIABLES DE ENTORNO
# ==========================================
# IMPORTANTE: Nunca subas tu archivo .env con valores reales a GitHub.

# URL pública de tu tienda (ejemplo: https://mi-tienda.vercel.app o dominio propio)
SITE_URL=https://tu-dominio.vercel.app

# ==========================================
# MERCADO PAGO CHECKOUT PRO
# ==========================================
# Obtenelo en: https://www.mercadopago.com.ar/developers/panel/app
# Para pruebas: usa tu Access Token de prueba (comienza con TEST-)
# Para ventas reales: usa tu Access Token de producción (comienza con APP_USR-)
MP_ACCESS_TOKEN=APP_USR-TU_ACCESS_TOKEN_AQUI

# Modo: "test" para pruebas sandbox o "production" para ventas en vivo
MP_MODE=production

# Clave secreta para validar Webhooks de Mercado Pago (opcional para pruebas, recomendado en producción)
MP_WEBHOOK_SECRET=CLAVE_SECRETA_DEL_WEBHOOK

# ==========================================
# SUPABASE (ALMACENAMIENTO PRIVADO DE PDFS)
# ==========================================
# Opcional para pruebas locales, recomendado para producción
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=PEGAR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=PEGAR_SERVICE_ROLE_KEY

# Contraseña para ingresar a /admin. Usá una contraseña larga y única.
ADMIN_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_SEGURA

# ==========================================
# GMAIL (ENVÍO AUTOMÁTICO DE PATRONES)
# ==========================================
# Requiere 'Contraseña de aplicación' de 16 caracteres de Google
GMAIL_USER=tu-cuenta@gmail.com
GMAIL_APP_PASSWORD=PEGA_LA_CLAVE_DE_16_CARACTERES_AQUI
OWNER_EMAIL=tu-email-de-notificaciones@ejemplo.com
